{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worddark.example/schemas/operation.schema.json",
  "title": "WordDark Operation",
  "description": "A request envelope for an operation. A valid document is not proof of permission or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "message_id", "correlation_id", "idempotency_key", "source", "destination", "action", "scope", "environment", "risk_level", "mode", "status", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "operation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 },
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "destination": { "type": "string", "minLength": 1, "maxLength": 128 },
    "action": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,127}$" },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true, "minItems": 1, "maxItems": 100 },
    "environment": { "enum": ["development", "test", "staging", "production"] },
    "risk_level": { "enum": ["low", "moderate", "high", "critical", "unassessed"] },
    "mode": { "enum": ["simulation", "manual", "execution"] },
    "approval_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "status": { "enum": ["draft", "pending_approval", "approved", "running", "succeeded", "rejected", "blocked", "failed", "cancelled", "rolled_back"] },
    "payload": { "type": "object" },
    "result_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
    "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}