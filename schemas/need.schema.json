{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worddark.example/schemas/need.schema.json",
  "title": "WordDark Need",
  "description": "A validated business or internal need. This schema does not authorize execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "need_id", "tenant_id", "objective", "constraints", "success_criteria", "priority", "risk_level", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "need_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_contract_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "context": { "type": "string", "maxLength": 10000 },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 100 },
    "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 2000 }, "maxItems": 100 },
    "priority": { "enum": ["low", "normal", "high", "urgent"] },
    "risk_level": { "enum": ["low", "moderate", "high", "critical", "unassessed"] },
    "status": { "enum": ["draft", "needs_information", "ready_for_planning", "planning", "planned", "blocked", "in_progress", "awaiting_review", "completed", "cancelled"] },
    "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}